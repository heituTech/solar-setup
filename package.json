{
  "name": "solar-setup",
  "version": "2.0.0",
  "private": true,
  "description": "Solar configurator and full-chain business workbench",
  "main": "server/index.js",
  "workspaces": [
    "apps/web",
    "services/*-service",
    "packages/*"
  ],
  "scripts": {
    "start": "node server/index.js",
    "start:legacy": "node server/index.js",
    "dev:legacy": "node --watch server/index.js",
    "dev": "npm run dev:new",
    "dev:new": "concurrently -n web,identity,sales,delivery,finance -c cyan,yellow,green,magenta,blue \"npm run dev:web\" \"npm run dev:identity\" \"npm run dev:sales\" \"npm run dev:delivery\" \"npm run dev:finance\"",
    "dev:web": "npm run dev --workspace @solar/web",
    "dev:identity": "npm run dev --workspace @solar/identity-service",
    "dev:sales": "npm run dev --workspace @solar/sales-service",
    "dev:delivery": "npm run dev --workspace @solar/delivery-service",
    "dev:finance": "npm run dev --workspace @solar/finance-service",
    "build": "npm run build --workspace @solar/web",
    "migrate": "npm run migrate --workspaces --if-present",
    "migrate:identity": "npm run migrate --workspace @solar/identity-service",
    "migrate:sales": "npm run migrate --workspace @solar/sales-service",
    "migrate:delivery": "npm run migrate --workspace @solar/delivery-service",
    "migrate:finance": "npm run migrate --workspace @solar/finance-service",
    "test": "npm run test --workspaces --if-present",
    "setup:env": "node scripts/setup-local-env.js",
    "seed:admin": "npm run seed --workspace @solar/identity-service",
    "init-db": "node server/init-db.js",
    "create-super-admin": "node server/scripts/create-super-admin.js",
    "hash-password": "node server/scripts/hash-password.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "country-state-city": "^3.2.1",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.11.0",
    "nodemailer": "^6.10.1"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "engines": {
    "node": ">=20"
  }
}
